+/**
+ * Make page: plain links to each current model's newest year page
+ * (/cars/<make>/<model>/<year>), e.g. "קיה ספורטאז' 2026".
+ *
+ * The newest model year is always indexable (isModelYearIndexable in
+ * src/lib/seoIndexing.ts), so every link here points at an indexable page.
+ * Models whose newest year is older than last year are left out: they are
+ * no longer sold new and their model page already covers them.
+ */
+import Link from 'next/link';
+import type { CarMake } from '@/lib/carsDb';
+
+interface Props {
+  make: CarMake;
+  locale: string;
+}
+
+export default function MakeNewestYearLinks({ make, locale }: Props) {
+  const isEn = locale === 'en';
+  const minYear = new Date().getFullYear() - 1;
+
+  const items = make.models
+    .filter((m) => m.years.length > 0)
+    .map((m) => ({ model: m, year: Math.max(...m.years) }))
+    .filter((x) => x.year >= minYear)
+    .sort((a, b) => b.year - a.year || (b.model.activeVehiclesIl ?? 0) - (a.model.activeVehiclesIl ?? 0));
+
+  if (items.length === 0) return null;
+
+  const chip: React.CSSProperties = {
+    padding: '5px 11px', borderRadius: 20, fontSize: '0.8rem', color: 'var(--accent)',
+    textDecoration: 'none', border: '1px solid var(--accent)', whiteSpace: 'nowrap',
+  };
+
+  return (
+    <nav aria-label={isEn ? `New ${make.nameEn} models` : `דגמי ${make.nameHe} חדשים`} style={{ marginBottom: 28 }}>
+      <h2 style={{ fontSize: '1.1rem', fontWeight: 700, color: 'var(--text)', marginBottom: 10 }}>
+        {isEn ? `New ${make.nameEn} models: prices and trims` : `דגמי ${make.nameHe} חדשים: מחיר וגרסאות`}
+      </h2>
+      <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8 }}>
+        {items.map(({ model, year }) => (
+          <Link key={model.slug} href={`/cars/${make.slug}/${model.slug}/${year}`} style={chip}>
+            {isEn ? `${make.nameEn} ${model.nameEn} ${year}` : `${make.nameHe} ${model.nameHe} ${year}`}
+          </Link>
+        ))}
+      </div>
+    </nav>
+  );
+}
